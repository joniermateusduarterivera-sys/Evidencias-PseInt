//2. Contador descendente: Como usuario, quiero ingresar un número para que el programa muestre una cuenta regresiva desde ese número hasta 1.
Algoritmo contadordescendente
	//declaracion de variables
	definir num Como Entero
	
	escribir "ingrese un numero"
	leer num
	
	Mientras num >= 1 Hacer
		escribir num
		num <- num - 1 
	Fin Mientras
	
FinAlgoritmo
