//14. Control de peso: Una báscula necesita informar si el peso registrado supera los 100 kilogramos.
Algoritmo controlpeso
	definir peso Como Real
	escribir "ingrese peso"
	leer peso
	
	si peso > 100 Entonces
		escribir "peso ingresado supera el limite"
	sino 
		escribir "peso dentro de lo normal"
	FinSi
	
	
FinAlgoritmo
