//5. Verificación de contraseña: Una plataforma necesita comprobar si la contraseña ingresada por un usuario coincide con la contraseña registrada.
Algoritmo verificacionContraseña
	definir contraseña como cadena
	escribir "ingrese la contraseña"
	leer contraseña
	
	si contraseña = "ADSO123" Entonces
		escribir "contraseña correcta"
	SiNo
		escribir "contraseña incorrecta"
		
	FinSi
	
FinAlgoritmo
