//15. Validación para conducir: Una escuela de conducción necesita verificar si una persona cumple la edad mínima de 16 años para iniciar su formación.
Algoritmo validacionConduccion
	definir edad Como Entero
	escribir "ingrese su edad"
	leer edad
	
	si edad >= 16 Entonces
		escribir "cumple con el minimo de edad requerido"
	sino 
		escribir "NO cumple con el minimo de edad requerido"
		
	FinSi
	
FinAlgoritmo
