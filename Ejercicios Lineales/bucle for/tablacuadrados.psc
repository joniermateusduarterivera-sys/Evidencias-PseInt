//16. Tabla de cuadrados: Una aplicación educativa necesita mostrar los cuadrados de los números comprendidos entre 1 y 20.
Algoritmo tablacuadrados
	//declaracion de variables
	definir i Como Entero
	definir num como entero
	definir cuadrado Como Entero
	
	num <- 20
	
	Para i <- 1 Hasta num Con Paso 1 Hacer
		cuadrado <- i * i
		Escribir "   ", i, "      ->      ", cuadrado
	Fin Para
	
	
FinAlgoritmo
